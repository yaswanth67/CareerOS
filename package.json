    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.25",
    "prisma": "^5.13.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.7.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "next": {
      "postcss": "^8.5.25"
    }
