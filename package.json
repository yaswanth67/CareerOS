{
  "name": "jobmatch-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development next dev -p 3000",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start -p 3000",
    "lint": "eslint .",
    "setup": "node scripts/setup.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "check-links": "tsx scripts/check-job-links.ts",
    "check-links:fix": "tsx scripts/check-job-links.ts --deactivate",
    "backfill:sponsorship": "tsx scripts/backfill-sponsorship.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.21.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.6.0",
    "@prisma/client": "^5.13.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.8.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.7",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
